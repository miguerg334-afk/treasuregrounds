<script>
  const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.documentElement.classList.add('motion-ready');

  if (reducedMotion.matches) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const revealPassedItems = () => {
      const triggerLine = window.innerHeight * 0.92;
      revealItems.forEach((item) => {
        if (item.classList.contains('is-visible')) return;
        if (item.getBoundingClientRect().top < triggerLine) item.classList.add('is-visible');
      });
    };

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, {
      rootMargin: '0px 0px -10% 0px',
      threshold: 0.12,
    });

    revealItems.forEach((item) => revealObserver.observe(item));
    window.addEventListener('scroll', revealPassedItems, { passive: true });
    window.addEventListener('resize', revealPassedItems, { passive: true });
    requestAnimationFrame(revealPassedItems);
  }

  const scrollExpandItems = Array.from(document.querySelectorAll<HTMLElement>('[data-scroll-expand]'));
  let expandFrame = 0;

  const setExpandProgress = (section: HTMLElement, progress: number) => {
    const compact = window.innerWidth <= 900;
    const startWidth = compact ? 88 : 72;
    const startHeight = compact ? 54 : 58;
    section.style.setProperty('--expand-progress', progress.toFixed(4));
    section.style.setProperty('--expand-width', `${startWidth + ((100 - startWidth) * progress)}vw`);
    section.style.setProperty('--expand-height', `${startHeight + ((100 - startHeight) * progress)}vh`);
    section.style.setProperty('--expand-radius', `${34 * (1 - progress)}px`);
    const sceneProgress = Math.min(1, Math.max(0, (progress - .68) / .24));
    const sceneEase = sceneProgress * sceneProgress * (3 - (2 * sceneProgress));
    section.style.setProperty('--scene-primary-opacity', (1 - sceneEase).toFixed(4));
    section.style.setProperty('--scene-secondary-opacity', sceneEase.toFixed(4));
    section.style.setProperty('--scene-primary-y', `${(-22 * sceneEase).toFixed(2)}px`);
    section.style.setProperty('--scene-secondary-y', `${(26 * (1 - sceneEase)).toFixed(2)}px`);
    section.classList.toggle('is-second-scene', sceneProgress > .5);
  };

  const updateScrollExpand = () => {
    expandFrame = 0;
    const viewportHeight = window.innerHeight;

    scrollExpandItems.forEach((section) => {
      const rect = section.getBoundingClientRect();
      const travel = Math.max(section.offsetHeight - viewportHeight, 1);
      const progress = Math.min(1, Math.max(0, -rect.top / (travel * .78)));
      setExpandProgress(section, progress);
    });
  };

  const requestExpandUpdate = () => {
    if (expandFrame) return;
    expandFrame = requestAnimationFrame(updateScrollExpand);
  };

  if (reducedMotion.matches) {
    scrollExpandItems.forEach((section) => setExpandProgress(section, 1));
  } else {
    window.addEventListener('scroll', requestExpandUpdate, { passive: true });
    window.addEventListener('resize', requestExpandUpdate, { passive: true });
    requestExpandUpdate();
  }

  const coffeeFillItems = Array.from(document.querySelectorAll<HTMLElement>('[data-coffee-fill]'));
  let coffeeFrame = 0;

  const updateCoffeeFill = () => {
    coffeeFrame = 0;
    const viewportHeight = window.innerHeight;

    coffeeFillItems.forEach((section) => {
      const rect = section.getBoundingClientRect();
      const start = viewportHeight * .82;
      const finish = Math.max(viewportHeight * .18, rect.height * .2);
      const scrollProgress = Math.min(1, Math.max(0, (start - rect.top) / (start + rect.height - finish)));
      const progress = Math.min(1, Math.max(0, (scrollProgress - .34) / .66));
      const eased = progress * progress * (3 - (2 * progress));
      section.style.setProperty('--coffee-offset', `${(-105 + (105 * eased)).toFixed(3)}%`);
    });
  };

  const requestCoffeeUpdate = () => {
    if (coffeeFrame) return;
    coffeeFrame = requestAnimationFrame(updateCoffeeFill);
  };

  if (reducedMotion.matches) {
    coffeeFillItems.forEach((section) => section.style.setProperty('--coffee-offset', '0%'));
  } else {
    window.addEventListener('scroll', requestCoffeeUpdate, { passive: true });
    window.addEventListener('resize', requestCoffeeUpdate, { passive: true });
    requestCoffeeUpdate();
  }
</script>
